{%- comment -%}
  Benefits Showcase — Dark section with a product switcher (clicker).
  Header: heading left, description + tab pills right.
  Below: 3 benefit cards (image + overlaid label) for the active product.
{%- endcomment -%}

<section class="py-20 md:py-28" style="background:#0a0a0a" data-benefits-showcase>
  <div class="container">
    <div class="mb-12 md:mb-16">
      {%- if section.settings.heading != blank -%}
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl mb-8" style="color:#fafafa">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        {%- if section.settings.description != blank -%}
          <p class="text-base font-light leading-relaxed max-w-lg" style="color:rgba(255,255,255,0.65)">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="flex flex-wrap gap-3 shrink-0">
            {%- for block in section.blocks -%}
              <button
                type="button"
                data-benefits-tab="{{ forloop.index0 }}"
                class="benefits-tab {% if forloop.first %}is-active{% endif %} h-11 px-6 rounded-full text-xs font-medium uppercase tracking-[0.1em] transition-colors"
              >
                {{ block.settings.label | default: block.settings.product.title }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Panels {%- endcomment -%}
    {%- for block in section.blocks -%}
      <div class="benefits-panel {% if forloop.first %}is-active{% endif %}" data-benefits-panel="{{ forloop.index0 }}">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {%- for i in (1..3) -%}
            {%- assign title_key = 'benefit_' | append: i | append: '_title' -%}
            {%- assign image_key = 'benefit_' | append: i | append: '_image' -%}
            {%- assign desc_key = 'benefit_' | append: i | append: '_description' -%}
            {%- assign benefit_title = block.settings[title_key] -%}
            {%- assign benefit_image = block.settings[image_key] -%}
            {%- assign benefit_description = block.settings[desc_key] -%}
            {%- if benefit_title != blank -%}
              <div>
                <div class="relative overflow-hidden bg-muted mb-4" style="aspect-ratio:3/4">
                  {%- if benefit_image -%}
                    <img
                      src="{{ benefit_image | image_url: width: 800 }}"
                      alt="{{ benefit_image.alt | default: benefit_title }}"
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="absolute inset-0 flex items-center justify-center" style="background:#e5e5e5">
                      <span class="text-xs uppercase tracking-widest text-muted-foreground">Image Coming Soon</span>
                    </div>
                  {%- endif -%}
                  <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(0,0,0,0.55), transparent 40%)"></div>
                  <p class="absolute top-5 left-5 right-5 text-xs md:text-sm uppercase tracking-[0.12em] text-white font-medium">
                    {{ benefit_title }}
                  </p>
                </div>
                {%- if benefit_description != blank -%}
                  <p class="text-sm font-light leading-relaxed" style="color:rgba(255,255,255,0.65)">
                    {{ benefit_description }}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .benefits-tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .benefits-tab.is-active {
    background: #fafafa;
    color: #0a0a0a;
    border-color: #fafafa;
  }
  .benefits-panel {
    display: none;
  }
  .benefits-panel.is-active {
    display: block;
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-benefits-showcase]').forEach(function (root) {
      var tabs = root.querySelectorAll('[data-benefits-tab]');
      var panels = root.querySelectorAll('[data-benefits-panel]');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var index = tab.dataset.benefitsTab;
          tabs.forEach(function (t) { t.classList.remove('is-active'); });
          panels.forEach(function (p) { p.classList.remove('is-active'); });
          tab.classList.add('is-active');
          var panel = root.querySelector('[data-benefits-panel="' + index + '"]');
          if (panel) panel.classList.add('is-active');
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Benefits Showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the miles ahead" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "product_tab",
      "name": "Product Tab",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (used as fallback tab label)" },
        { "type": "text", "id": "label", "label": "Tab Label" },
        { "type": "text", "id": "benefit_1_title", "label": "Benefit 1 Title" },
        { "type": "image_picker", "id": "benefit_1_image", "label": "Benefit 1 Image" },
        { "type": "textarea", "id": "benefit_1_description", "label": "Benefit 1 Description" },
        { "type": "text", "id": "benefit_2_title", "label": "Benefit 2 Title" },
        { "type": "image_picker", "id": "benefit_2_image", "label": "Benefit 2 Image" },
        { "type": "textarea", "id": "benefit_2_description", "label": "Benefit 2 Description" },
        { "type": "text", "id": "benefit_3_title", "label": "Benefit 3 Title" },
        { "type": "image_picker", "id": "benefit_3_image", "label": "Benefit 3 Image" },
        { "type": "textarea", "id": "benefit_3_description", "label": "Benefit 3 Description" }
      ]
    }
  ],
  "presets": [{ "name": "Benefits Showcase" }]
}
{% endschema %}
