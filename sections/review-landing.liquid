{%- comment -%}
  Review Landing — destination for review-request emails.
  Lists products with direct links to each product page's review form.
{%- endcomment -%}

<section class="py-16 md:py-24 bg-background">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-5 font-light">Reviews</p>
      <h1 class="font-serif text-4xl md:text-5xl tracking-tight mb-4">{{ section.settings.heading | default: 'Tell Us How It Held Up' }}</h1>
      <p class="text-base md:text-lg text-muted-foreground font-light leading-relaxed max-w-xl mb-12 md:mb-16">
        {{ section.settings.intro | default: 'Pick the product you ran in. Your review is read by us and helps the next runner choose right.' }}
      </p>

      <div class="space-y-5">
        {%- for product in collections.all.products limit: 6 -%}
          <a href="{{ product.url }}#reviews" class="group flex items-center gap-5 md:gap-8 bg-secondary p-4 md:p-5 hover:bg-muted transition-colors">
            <div class="w-20 h-20 md:w-24 md:h-24 shrink-0 bg-muted overflow-hidden">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.featured_image.alt | default: product.title }}" class="w-full h-full object-cover" loading="lazy">
              {%- endif -%}
            </div>
            <div class="flex-1 min-w-0">
              <h2 class="text-base md:text-lg font-medium tracking-tight mb-1">{{ product.title }}</h2>
              <p class="text-sm text-muted-foreground font-light hidden sm:block">{{ product.description | strip_html | truncate: 90 }}</p>
            </div>
            <span class="shrink-0 text-xs font-medium uppercase tracking-[0.15em] underline underline-offset-4 group-hover:opacity-60 transition-opacity">
              Write a Review
            </span>
          </a>
        {%- endfor -%}
      </div>

      <p class="text-sm text-muted-foreground font-light leading-relaxed mt-10">
        Prefer email? Write to
        <a href="mailto:hello@aura-running.com" class="underline underline-offset-4 hover:opacity-60 transition-opacity">hello@aura-running.com</a>
        and we will post it for you.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Review Landing",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell Us How It Held Up" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "presets": [{ "name": "Review Landing" }]
}
{% endschema %}
