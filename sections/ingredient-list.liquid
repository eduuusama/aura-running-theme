{%- comment -%}
  Ingredient List — Stacked full-width rectangles, centered column.
  Each band: ingredient photo (or muted blank), name overlaid.
  Used by the Ingredients blog template.
{%- endcomment -%}

<section class="py-16 md:py-24 bg-background">
  <div class="container">
    <div class="max-w-4xl mx-auto space-y-6">
      {% paginate blog.articles by 24 %}
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="group block relative overflow-hidden bg-muted aspect-[21/9]" {% if forloop.first %}{% endif %}>
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 1600 }}"
                alt="{{ article.image.alt | default: article.title }}"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              >
              <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors duration-500"></div>
              <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
                <h2 class="font-serif text-2xl md:text-4xl text-white mb-2">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}
                  <p class="text-sm text-white/80 font-light max-w-lg hidden md:block">{{ article.excerpt | strip_html }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
                <h2 class="font-serif text-2xl md:text-4xl text-foreground mb-2 group-hover:opacity-60 transition-opacity">{{ article.title }}</h2>
                {%- if article.excerpt != blank -%}
                  <p class="text-sm text-muted-foreground font-light max-w-lg hidden md:block">{{ article.excerpt | strip_html }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </a>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div class="flex justify-center gap-4 pt-8">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="text-sm font-medium underline underline-offset-4 hover:opacity-60 transition-opacity">Previous</a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="text-sm font-medium underline underline-offset-4 hover:opacity-60 transition-opacity">Next</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient List",
  "settings": [],
  "presets": [{ "name": "Ingredient List" }]
}
{% endschema %}
