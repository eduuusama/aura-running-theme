{%- comment -%}
  Ingredient List — Stacked full-width card rectangles.
  Each card: light container, serif title + description on top,
  wide rounded image block below. Used by the Ingredients blog template.
{%- endcomment -%}

<section class="py-16 md:py-24 bg-background">
  <div class="container">
    <div class="max-w-3xl mx-auto space-y-5 md:space-y-6">
      {% paginate blog.articles by 24 %}
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="group block bg-secondary rounded-2xl p-5 md:p-7">
            <h2 class="font-serif text-2xl md:text-3xl tracking-tight mb-2 md:mb-3 group-hover:opacity-70 transition-opacity">
              {{ article.title }}
            </h2>
            {%- if article.excerpt != blank -%}
              <p class="text-sm md:text-base text-muted-foreground font-light leading-relaxed max-w-xl mb-4 md:mb-6">
                {{ article.excerpt | strip_html }}
              </p>
            {%- endif -%}
            <div class="relative overflow-hidden rounded-xl bg-muted aspect-[4/1]">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 1600 }}"
                  alt="{{ article.image.alt | default: article.title }}"
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                >
              {%- else -%}
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-xs uppercase tracking-widest text-muted-foreground">{{ article.title }}</span>
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div class="flex justify-center gap-4 pt-8">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="text-sm font-medium underline underline-offset-4 hover:opacity-60 transition-opacity">Previous</a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="text-sm font-medium underline underline-offset-4 hover:opacity-60 transition-opacity">Next</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient List",
  "settings": [],
  "presets": [{ "name": "Ingredient List" }]
}
{% endschema %}
