{%- comment -%}
  Product Data — lab-style stats section.
  Stat arcs + a minimal comparison chart, both configurable per product.
  Animates on first scroll into view: arcs and chart lines draw in,
  numeric values count up. Values are merchant-entered estimates; the
  footnote setting renders a disclaimer.
{%- endcomment -%}

{%- assign sid = section.id -%}
<section class="py-20 md:py-28 product-data-section" style="background:#0a0a0a" id="data-{{ sid }}">
  <div class="container">
    <div class="mb-14 md:mb-20 pd-fade">
      {%- if section.settings.label != blank -%}
        <p class="text-xs tracking-[0.2em] uppercase mb-5 font-light" style="color:rgba(255,255,255,0.5)">
          {{ section.settings.label }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl" style="color:#fafafa">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="text-base font-light leading-relaxed max-w-lg mt-6" style="color:rgba(255,255,255,0.65)">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} One row: stat rings + chart {%- endcomment -%}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-14 items-center">
      {%- for block in section.blocks -%}
        <div class="flex flex-col items-center pd-fade" style="transition-delay: {{ forloop.index0 | times: 150 }}ms" {{ block.shopify_attributes }}>
          <div class="relative w-[220px] h-[220px]">
            {%- assign vis = block.settings.visual | default: 'percent' -%}
            {%- assign pct = block.settings.percent | default: 0 -%}
            {%- assign segs = block.settings.segments | default: 0 -%}
            <svg viewBox="0 0 240 240" class="absolute inset-0 w-full h-full" fill="none" aria-hidden="true">
              {%- if vis == 'segments' and segs > 0 -%}
                {%- assign unit = 628.3185 | divided_by: segs -%}
                {%- assign dash = unit | times: 0.7 -%}
                {%- assign gap = unit | times: 0.3 -%}
                {%- assign seg_off = dash | divided_by: 2.0 | plus: 157.0796 -%}
                <circle class="pd-seg" cx="120" cy="120" r="100" stroke="#fafafa" stroke-width="2.5" stroke-dasharray="{{ dash }} {{ gap }}" stroke-dashoffset="{{ seg_off }}" fill="none"/>
              {%- else -%}
                <circle cx="120" cy="120" r="100" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
                <circle class="pd-arc" cx="120" cy="120" r="100" pathLength="100" stroke="#fafafa" stroke-width="1.5" stroke-dasharray="0 100" data-pct="{{ pct }}" transform="rotate(-90 120 120)"/>
                <rect x="116.5" y="16.5" width="7" height="7" fill="#fafafa"/>
                {%- if pct > 0 -%}
                  {%- assign deg = pct | times: 3.6 -%}
                  <g transform="rotate({{ deg }} 120 120)"><rect class="pd-dot" x="116.5" y="16.5" width="7" height="7" fill="#fafafa"/></g>
                {%- endif -%}
              {%- endif -%}
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-center px-9">
              <p class="text-5xl font-light pd-count" data-value="{{ block.settings.value | escape }}" style="color:#fafafa">{{ block.settings.value }}</p>
            </div>
          </div>
          <p class="text-[13px] font-light leading-snug text-center max-w-[220px] mt-5" style="color:rgba(255,255,255,0.75)">{{ block.settings.caption }}</p>
        </div>
      {%- endfor -%}

      {%- comment -%} Comparison chart as fourth column {%- endcomment -%}
      {%- if section.settings.show_chart -%}
        <div class="pd-fade sm:col-span-2 lg:col-span-1" style="transition-delay: 450ms">
          <p class="text-xs tracking-[0.2em] uppercase mb-5 font-light" style="color:rgba(255,255,255,0.5)">
            {{ section.settings.chart_title }}
          </p>
          <svg viewBox="0 0 800 300" class="w-full h-auto" fill="none" role="img" aria-label="Chart: {{ section.settings.chart_title | escape }}">
            <path class="pd-draw" d="{{ section.settings.compare_path | default: 'M 40 130 C 200 118, 400 84, 720 40' }}" stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-dasharray="7 8"/>
            <text x="40" y="{{ section.settings.compare_label_y | default: 112 }}" fill="rgba(255,255,255,0.5)" font-size="24" font-family="Inter, sans-serif" letter-spacing="0.06em">{{ section.settings.compare_label }}</text>

            <path class="pd-draw" d="{{ section.settings.product_path | default: 'M 40 216 C 220 214, 460 210, 720 200' }}" stroke="#fafafa" stroke-width="3"/>
            <rect class="pd-dot" x="{{ section.settings.product_dot_x | default: 716.5 }}" y="{{ section.settings.product_dot_y | default: 196.5 }}" width="11" height="11" fill="#fafafa"/>
            <text x="40" y="{{ section.settings.product_label_y | default: 200 }}" fill="#fafafa" font-size="24" font-family="Inter, sans-serif" letter-spacing="0.06em">{{ section.settings.product_label }}</text>

            <line x1="40" y1="252" x2="760" y2="252" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
            {%- for i in (0..36) -%}
              {%- assign x = i | times: 20 | plus: 40 -%}
              {%- assign rem = i | modulo: 9 -%}
              <line x1="{{ x }}" y1="252" x2="{{ x }}" y2="{% if rem == 0 %}238{% else %}245{% endif %}" stroke="rgba(255,255,255,{% if rem == 0 %}0.4{% else %}0.2{% endif %})" stroke-width="1.5"/>
            {%- endfor -%}
            <text x="40" y="290" fill="rgba(255,255,255,0.5)" font-size="22" font-family="Inter, sans-serif">{{ section.settings.x0 }}</text>
            <text x="300" y="290" fill="rgba(255,255,255,0.5)" font-size="22" font-family="Inter, sans-serif">{{ section.settings.x1 }}</text>
            <text x="560" y="290" fill="rgba(255,255,255,0.5)" font-size="22" font-family="Inter, sans-serif">{{ section.settings.x2 }}</text>
            <text x="710" y="290" fill="rgba(255,255,255,0.5)" font-size="22" font-family="Inter, sans-serif">{{ section.settings.x3 }}</text>
          </svg>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="text-xs font-light mt-14 max-w-xl pd-fade" style="transition-delay: 450ms; color:rgba(255,255,255,0.35)">
        {{ section.settings.footnote }}
      </p>
    {%- endif -%}
  </div>
</section>

<style>
  .product-data-section .pd-fade {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }
  .product-data-section.pd-visible .pd-fade {
    opacity: 1;
    transform: translateY(0);
  }
  .product-data-section .pd-dot {
    opacity: 0;
    transition: opacity 0.4s ease 1.4s;
  }
  .product-data-section.pd-visible .pd-dot {
    opacity: 1;
  }
  .product-data-section .pd-seg {
    opacity: 0;
    transform-box: fill-box;
    transition: opacity 1.2s ease 0.3s;
  }
  .product-data-section.pd-visible .pd-seg {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .product-data-section .pd-fade,
    .product-data-section .pd-dot { opacity: 1; transform: none; transition: none; }
    .product-data-section .pd-draw { stroke-dasharray: none !important; stroke-dashoffset: 0 !important; transition: none !important; }
    .product-data-section .pd-seg { opacity: 1; }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('data-{{ sid }}');
    if (!section || section.dataset.pdInit) return;
    section.dataset.pdInit = '1';

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var draws = section.querySelectorAll('path.pd-draw');
    if (!reduced) {
      draws.forEach(function (p) {
        var len = p.getTotalLength();
        var dash = p.getAttribute('stroke-dasharray');
        p.dataset.pdDashed = dash || '';
        p.style.strokeDasharray = len;
        p.style.strokeDashoffset = len;
      });
    }

    function countUp(el) {
      var raw = el.dataset.value || '';
      var m = raw.match(/^(\d+(?:\.\d+)?)(.*)$/);
      if (!m) return;
      var target = parseFloat(m[1]);
      var suffix = m[2];
      var decimals = (m[1].split('.')[1] || '').length;
      var start = null;
      var dur = 1300;
      function step(ts) {
        if (!start) start = ts;
        var t = Math.min((ts - start) / dur, 1);
        var eased = 1 - Math.pow(1 - t, 3);
        el.textContent = (target * eased).toFixed(decimals) + suffix;
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = raw;
      }
      requestAnimationFrame(step);
    }

    function reveal() {
      section.classList.add('pd-visible');
      if (reduced) {
        section.querySelectorAll('.pd-arc').forEach(function (c) {
          var pct = parseFloat(c.dataset.pct) || 0;
          c.style.strokeDasharray = pct + ' ' + (100 - pct);
        });
      }
      if (!reduced) {
        draws.forEach(function (p) {
          p.style.transition = 'stroke-dashoffset 1.6s cubic-bezier(0.4, 0, 0.2, 1)';
          p.style.strokeDashoffset = '0';
          if (p.dataset.pdDashed) {
            p.addEventListener('transitionend', function () {
              p.style.transition = 'none';
              p.style.strokeDasharray = p.dataset.pdDashed;
              p.style.strokeDashoffset = '0';
            }, { once: true });
          }
        });
        section.querySelectorAll('.pd-arc').forEach(function (c) {
          var pct = parseFloat(c.dataset.pct) || 0;
          c.style.transition = 'stroke-dasharray 1.6s cubic-bezier(0.4, 0, 0.2, 1)';
          requestAnimationFrame(function () {
            c.style.strokeDasharray = pct + ' ' + (100 - pct);
          });
        });
        section.querySelectorAll('.pd-count').forEach(countUp);
      }
    }

    if ('IntersectionObserver' in window && !reduced) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { reveal(); io.disconnect(); }
        });
      }, { threshold: 0.12 });
      io.observe(section);
    } else {
      reveal();
    }
  })();
</script>

{% schema %}
{
  "name": "Product Data",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Lab Notes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Data" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "checkbox", "id": "show_chart", "label": "Show chart", "default": true },
    { "type": "text", "id": "chart_title", "label": "Chart title" },
    { "type": "text", "id": "compare_label", "label": "Comparison line label", "default": "UNTREATED SKIN" },
    { "type": "text", "id": "compare_path", "label": "Comparison line SVG path" },
    { "type": "number", "id": "compare_label_y", "label": "Comparison label Y" },
    { "type": "text", "id": "product_label", "label": "Product line label" },
    { "type": "text", "id": "product_path", "label": "Product line SVG path" },
    { "type": "number", "id": "product_label_y", "label": "Product label Y" },
    { "type": "number", "id": "product_dot_x", "label": "Product endpoint dot X" },
    { "type": "number", "id": "product_dot_y", "label": "Product endpoint dot Y" },
    { "type": "text", "id": "x0", "label": "X axis label 1", "default": "MI 0" },
    { "type": "text", "id": "x1", "label": "X axis label 2", "default": "10" },
    { "type": "text", "id": "x2", "label": "X axis label 3", "default": "20" },
    { "type": "text", "id": "x3", "label": "X axis label 4", "default": "26.2" },
    { "type": "textarea", "id": "footnote", "label": "Footnote / disclaimer" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value (e.g. 78%)" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "select", "id": "visual", "label": "Ring visual", "options": [ { "value": "percent", "label": "Percent fill" }, { "value": "segments", "label": "Segment count" } ], "default": "percent" },
        { "type": "number", "id": "percent", "label": "Percent fill (0-100)" },
        { "type": "number", "id": "segments", "label": "Number of segments" }
      ]
    }
  ],
  "presets": [{ "name": "Product Data" }]
}
{% endschema %}
