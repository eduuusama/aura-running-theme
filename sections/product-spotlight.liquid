{%- comment -%}
  Product Spotlight — 50/50 split
  Left: auto-rotating single-image carousel (one feature at a time,
  crossfades every 3s, small progress dots overlay).
  Right: spotlighted product on a dark panel (night mode for this
  section only — hardcoded colors, theme has no dark-mode tokens).
{%- endcomment -%}

{%- assign sp = section.settings.product -%}

<section class="grid grid-cols-1 lg:grid-cols-2" data-spotlight-carousel>
  {%- comment -%} Left — Rotating feature images {%- endcomment -%}
  <div class="relative" style="min-height:480px">
    {%- for block in section.blocks -%}
      <div
        class="spotlight-slide absolute inset-0 {% if forloop.first %}is-active{% endif %}"
        data-spotlight-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | default: block.settings.title }}"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          >
        {%- else -%}
          <div class="absolute inset-0 bg-muted"></div>
        {%- endif -%}
        <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0.12) 45%, transparent 70%)"></div>
        <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-10">
          <h3 class="font-serif text-xl md:text-2xl text-white mb-2">{{ block.settings.title }}</h3>
          <p class="text-sm text-white/80 font-light leading-relaxed max-w-md">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}

    {%- comment -%} Loading dots {%- endcomment -%}
    {%- if section.blocks.size > 1 -%}
      <div class="absolute top-6 left-6 md:left-10 z-20 flex gap-3">
        {%- for block in section.blocks -%}
          <span class="spotlight-dot {% if forloop.first %}is-active{% endif %}" data-spotlight-dot="{{ forloop.index0 }}">
            <svg viewBox="0 0 16 16" width="14" height="14">
              <circle cx="8" cy="8" r="6" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="2"></circle>
              <circle class="spotlight-dot-ring" cx="8" cy="8" r="6" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="37.7" stroke-dashoffset="37.7" transform="rotate(-90 8 8)"></circle>
            </svg>
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Right — Spotlight product {%- endcomment -%}
  <div class="bg-secondary px-6 md:px-12 lg:px-16 py-16 lg:py-24 flex flex-col items-center justify-center text-center">
    {%- if section.settings.label != blank -%}
      <p class="text-xs tracking-[0.2em] uppercase mb-4 font-light text-muted-foreground">
        {{ section.settings.label }}
      </p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="font-serif text-3xl md:text-4xl mb-4 text-foreground">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="font-serif text-xl md:text-2xl leading-snug max-w-lg mx-auto mb-10 text-foreground">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    {%- if sp != blank -%}
      <a href="{{ sp.url }}" class="block w-56 md:w-64 mb-10 group">
        {%- if sp.featured_image -%}
          <img
            src="{{ sp.featured_image | image_url: width: 600 }}"
            alt="{{ sp.featured_image.alt | default: sp.title }}"
            class="w-full group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          >
        {%- endif -%}
      </a>

      {%- if sp.available -%}
        <button
          class="w-full max-w-sm h-14 rounded-none bg-foreground text-background hover:bg-foreground/90 transition-colors text-xs font-medium uppercase tracking-[0.15em]"
          onclick="event.preventDefault(); document.dispatchEvent(new CustomEvent('cart:add', { detail: { id: {{ sp.selected_or_first_available_variant.id }} } }))"
        >
          {{ 'general.add_to_cart' | t | default: 'Add to Cart' }}
        </button>
      {%- else -%}
        <button
          disabled
          class="w-full max-w-sm h-14 rounded-none bg-muted text-muted-foreground text-xs font-medium uppercase tracking-[0.15em] disabled:cursor-not-allowed"
        >
          {{ 'general.sold_out' | t | default: 'Sold Out' }}
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .spotlight-slide {
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }
  .spotlight-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .spotlight-dot-ring {
    stroke-dashoffset: 37.7;
  }
  .spotlight-dot.is-active .spotlight-dot-ring {
    animation: spotlight-ring 3s linear forwards;
  }
  @keyframes spotlight-ring {
    from { stroke-dashoffset: 37.7; }
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-spotlight-carousel]').forEach(function (root) {
      var slides = root.querySelectorAll('[data-spotlight-slide]');
      var dots = root.querySelectorAll('[data-spotlight-dot]');
      if (slides.length < 2) return;
      var index = 0;
      setInterval(function () {
        slides[index].classList.remove('is-active');
        dots[index] && dots[index].classList.remove('is-active');
        index = (index + 1) % slides.length;
        slides[index].classList.add('is-active');
        var ring = dots[index] && dots[index].querySelector('.spotlight-dot-ring');
        if (ring) {
          ring.style.animation = 'none';
          void ring.offsetWidth;
          ring.style.animation = '';
          dots[index].classList.add('is-active');
        }
      }, 3000);
    });
  })();
</script>

{% schema %}
{
  "name": "Product Spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Spotlight Product" },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Product Spotlight" }]
}
{% endschema %}
