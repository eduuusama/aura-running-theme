{%- comment -%}
  Product Spotlight — 50/50 split
  Left: three feature rows (image + title + one-line text)
  Right: spotlighted product with label, heading, description,
  image, price, add to cart (Aesop-style presentation)
{%- endcomment -%}

{%- assign sp = section.settings.product -%}

<section class="grid grid-cols-1 lg:grid-cols-2">
  {%- comment -%} Left — Full-bleed feature images with overlaid text {%- endcomment -%}
  <div class="flex flex-col">
    {%- for block in section.blocks -%}
      <div class="relative flex-1 overflow-hidden group" style="min-height:260px" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | default: block.settings.title }}"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          >
        {%- else -%}
          <div class="absolute inset-0 bg-muted"></div>
        {%- endif -%}
        <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0.12) 45%, transparent 70%)"></div>
        <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-10">
          <h3 class="font-serif text-xl md:text-2xl text-white mb-2">{{ block.settings.title }}</h3>
          <p class="text-sm text-white/80 font-light leading-relaxed max-w-md">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Right — Spotlight product {%- endcomment -%}
  <div class="bg-secondary px-6 md:px-12 lg:px-16 py-16 lg:py-24 flex flex-col items-center justify-center text-center">
    {%- if section.settings.label != blank -%}
      <p class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 font-light">
        {{ section.settings.label }}
      </p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="font-serif text-3xl md:text-4xl mb-4">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="text-base text-muted-foreground font-light leading-relaxed max-w-md mx-auto mb-10">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    {%- if sp != blank -%}
      <a href="{{ sp.url }}" class="block w-56 md:w-64 mb-8 group">
        {%- if sp.featured_image -%}
          <img
            src="{{ sp.featured_image | image_url: width: 600 }}"
            alt="{{ sp.featured_image.alt | default: sp.title }}"
            class="w-full group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          >
        {%- endif -%}
      </a>

      <a href="{{ sp.url }}" class="hover:opacity-60 transition-opacity">
        <h3 class="text-base font-medium tracking-tight mb-2">{{ sp.title }}</h3>
      </a>
      <p class="text-sm font-light mb-6">{{ sp.price | money }}</p>

      {%- if sp.available -%}
        <button
          class="w-full max-w-sm h-14 rounded-none bg-foreground text-background hover:bg-foreground/90 transition-colors text-xs font-medium uppercase tracking-[0.15em]"
          onclick="event.preventDefault(); document.dispatchEvent(new CustomEvent('cart:add', { detail: { id: {{ sp.selected_or_first_available_variant.id }} } }))"
        >
          {{ 'general.add_to_cart' | t | default: 'Add to Cart' }}
        </button>
      {%- else -%}
        <button
          disabled
          class="w-full max-w-sm h-14 rounded-none bg-muted text-muted-foreground text-xs font-medium uppercase tracking-[0.15em] disabled:cursor-not-allowed"
        >
          {{ 'general.sold_out' | t | default: 'Sold Out' }}
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Spotlight Product" },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Product Spotlight" }]
}
{% endschema %}
