{%- comment -%}
  Product Benefits — Label + heading + intro text, then 3 solid cards
  Card design mirrors editorial-grid / article-card
{%- endcomment -%}

<section class="py-20 md:py-28 bg-secondary">
  <div class="container">
    {%- if section.settings.label != blank -%}
      <p class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 font-light">
        {{ section.settings.label }}
      </p>
    {%- endif -%}

    <h2 class="text-3xl md:text-4xl font-light tracking-tight mb-6">
      {{ section.settings.heading | default: 'Product Benefits' }}
    </h2>

    {%- if section.settings.description != blank -%}
      <p class="text-base text-muted-foreground font-light leading-relaxed max-w-2xl mb-14">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {%- for block in section.blocks -%}
        <div class="group" {{ block.shopify_attributes }}>
          <div class="block aspect-[4/3] bg-muted mb-6 overflow-hidden">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | default: block.settings.name }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              >
            {%- else -%}
              <div class="w-full h-full flex items-center justify-center text-muted-foreground">
                <span class="text-xs uppercase tracking-widest">Image Coming Soon</span>
              </div>
            {%- endif -%}
          </div>

          <h3 class="font-serif text-lg mb-3">
            {{ block.settings.name }}
          </h3>

          <p class="text-sm text-muted-foreground leading-relaxed">
            {{ block.settings.text }}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Benefits",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "PERFORMANCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product Benefits" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        { "type": "text", "id": "name", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "Product Benefits" }]
}
{% endschema %}
