{%- comment -%}
  Featured Products — Centered header + 3-column product row
  Cards mirror the Shop page product-card (left-aligned, dual-image
  hover, full-width uppercase button). Sold out renders grey.
{%- endcomment -%}

<section class="py-20 md:py-28 bg-background">
  <div class="container">
    {%- comment -%} Centered header {%- endcomment -%}
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
      {%- if section.settings.label != blank -%}
        <p class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-5 font-light">
          {{ section.settings.label }}
        </p>
      {%- endif -%}
      <h2 class="font-serif text-3xl md:text-4xl mb-5">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.description != blank -%}
        <p class="text-base text-muted-foreground font-light leading-relaxed">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Product columns {%- endcomment -%}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {%- for block in section.blocks -%}
        {%- assign fp = block.settings.product -%}
        {%- if fp != blank -%}
          <div class="group block bg-background" {{ block.shopify_attributes }}>
            <a href="{{ fp.url }}" class="block">
              <div class="aspect-square overflow-hidden bg-muted mb-6 relative">
                {%- if fp.featured_image -%}
                  <img
                    src="{{ fp.featured_image | image_url: width: 800 }}"
                    alt="{{ fp.featured_image.alt | default: fp.title }}"
                    class="product-card-image-main w-full h-full object-cover transition-opacity duration-500"
                    loading="lazy"
                  >
                {%- endif -%}
                {%- if fp.images.size > 1 -%}
                  <img
                    src="{{ fp.images[1] | image_url: width: 800 }}"
                    alt="{{ fp.images[1].alt | default: fp.title }}"
                    class="product-card-image-hover w-full h-full object-cover"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
            </a>

            <div class="px-1">
              <a href="{{ fp.url }}">
                <h3 class="text-base font-medium tracking-tight mb-1 group-hover:opacity-60 transition-opacity">
                  {{ fp.title }}
                </h3>
              </a>

              {%- if block.settings.descriptor != blank -%}
                <p class="text-sm text-muted-foreground font-light line-clamp-2 mb-3">
                  {{ block.settings.descriptor }}
                </p>
              {%- endif -%}

              <p class="text-sm font-light mb-4">{{ fp.price | money }}</p>

              {%- if fp.available -%}
                <button
                  class="w-full h-14 rounded-none bg-foreground text-background hover:bg-foreground/90 transition-colors text-xs font-medium uppercase tracking-[0.15em]"
                  onclick="event.preventDefault(); document.dispatchEvent(new CustomEvent('cart:add', { detail: { id: {{ fp.selected_or_first_available_variant.id }} } }))"
                >
                  {{ 'general.add_to_cart' | t | default: 'Add to Cart' }}
                </button>
              {%- else -%}
                <button
                  disabled
                  class="w-full h-14 rounded-none bg-muted text-muted-foreground text-xs font-medium uppercase tracking-[0.15em] disabled:cursor-not-allowed"
                >
                  {{ 'general.sold_out' | t | default: 'Sold Out' }}
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The System" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "textarea", "id": "descriptor", "label": "Short Descriptor" }
      ]
    }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
