{%- comment -%}
  Featured Products — Centered header + 3-column product row
  Structure: label / heading / description, then image, title,
  descriptor, size, price, add-to-cart per product.
{%- endcomment -%}

<section class="py-20 md:py-28 bg-background">
  <div class="container">
    {%- comment -%} Centered header {%- endcomment -%}
    <div class="text-center mb-14">
      {%- if section.settings.label != blank -%}
        <p class="text-xs tracking-[0.2em] uppercase text-muted-foreground mb-4 font-light">
          {{ section.settings.label }}
        </p>
      {%- endif -%}
      <h2 class="font-serif text-3xl md:text-4xl mb-4">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.description != blank -%}
        <p class="text-base text-muted-foreground font-light leading-relaxed max-w-2xl mx-auto">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Product columns {%- endcomment -%}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {%- for block in section.blocks -%}
        {%- assign fp = block.settings.product -%}
        {%- if fp != blank -%}
          <div class="group flex flex-col text-center" {{ block.shopify_attributes }}>
            <a href="{{ fp.url }}" class="block aspect-square bg-secondary mb-6 overflow-hidden">
              {%- if fp.featured_image -%}
                <img
                  src="{{ fp.featured_image | image_url: width: 800 }}"
                  alt="{{ fp.featured_image.alt | default: fp.title }}"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                >
              {%- endif -%}
            </a>

            <a href="{{ fp.url }}" class="hover:opacity-60 transition-opacity">
              <h3 class="font-serif text-lg mb-3">{{ fp.title }}</h3>
            </a>

            {%- if block.settings.descriptor != blank -%}
              <p class="text-sm text-muted-foreground font-light leading-relaxed mb-4 max-w-xs mx-auto">
                {{ block.settings.descriptor }}
              </p>
            {%- endif -%}

            <div class="mt-auto">
              {%- if block.settings.size != blank -%}
                <p class="text-xs text-muted-foreground font-light mb-1">{{ block.settings.size }}</p>
              {%- endif -%}

              <p class="text-base font-light mb-5">
                {{ fp.selected_or_first_available_variant.price | money }}
              </p>

              {%- if fp.available -%}
                <button
                  onclick="window.CartDrawer.addItem({ id: {{ fp.selected_or_first_available_variant.id }} })"
                  class="w-full h-12 bg-foreground text-background text-xs font-medium uppercase tracking-[0.15em] hover:bg-foreground/90 transition-colors"
                >
                  Add to cart
                </button>
              {%- else -%}
                <button
                  disabled
                  class="w-full h-12 bg-muted text-muted-foreground text-xs font-medium uppercase tracking-[0.15em] disabled:cursor-not-allowed"
                >
                  {{ 'general.sold_out' | t | default: 'Sold Out' }}
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The System" },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "textarea", "id": "descriptor", "label": "Short Descriptor" },
        { "type": "text", "id": "size", "label": "Size Line", "default": "One size · 2 fl oz (59 mL)" }
      ]
    }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
