{%- comment -%}
  Product Value Props — Slim 4-up row of short claims, used just below the hero
  on product pages that need a quick "why this product" scan before ingredients.
{%- endcomment -%}

<section class="py-12 md:py-16 border-t border-b border-border">
  <div class="container">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
      {%- for block in section.blocks -%}
        <div class="text-center lg:text-left" {{ block.shopify_attributes }}>
          <h3 class="font-serif text-lg md:text-xl mb-2">{{ block.settings.title }}</h3>
          <p class="text-sm text-muted-foreground font-light leading-relaxed">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Value Props",
  "blocks": [
    {
      "type": "value_prop",
      "name": "Value Prop",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Product Value Props" }]
}
{% endschema %}
