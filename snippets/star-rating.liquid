{%- comment -%}
  Star Rating — renders 5 stars for a given rating (integer 1-5).
  Usage: {% render 'star-rating', rating: 4, size: 16 %}
{%- endcomment -%}
{%- assign star_size = size | default: 16 -%}
<span class="inline-flex items-center gap-0.5" aria-label="{{ rating }} out of 5 stars">
  {%- for i in (1..5) -%}
    <svg width="{{ star_size }}" height="{{ star_size }}" viewBox="0 0 24 24" fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path d="M12 3.5l2.47 5.34 5.85.63-4.36 3.96 1.17 5.77L12 16.3l-5.13 2.9 1.17-5.77-4.36-3.96 5.85-.63z"/>
    </svg>
  {%- endfor -%}
</span>
